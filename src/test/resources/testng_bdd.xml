<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">

<!-- ===========================================================================================
     thread-count is deliberately 1. Two pieces of shared state make concurrent <test> blocks
     unsafe today:

       1. Hooks.softAssert is "public static SoftAssert" - ONE instance for the whole JVM.
          @Before replaces it and @After calls assertAll() on it, so with two scenarios in
          flight one thread wipes the other's collected assertions and failures get reported
          against the wrong scenario, or disappear.

       2. Several blocks below share a test.group, and therefore a login. The same account
          driving two browsers at once corrupts cart and profile state - e.g. Cart_AddToCart
          empties the cart while another block is adding to it.

     Raising thread-count is worth doing, but fix (1) by making softAssert a ThreadLocal and
     give every concurrently-running block its own test.group first. TestGroupContext is
     already ThreadLocal, so it is only softAssert and the user allocation that block this.
     =========================================================================================== -->
<suite verbose="1" name="Jsw automation" parallel="tests" thread-count="5"
       data-provider-thread-count="1" annotations="JDK">

    <listeners>
        <listener class-name="com.qapitol.jsw.config.TestGroupListener"/>
    </listeners>

    <!-- env / data.env are set by GlobalConfigProperties from -Denv (default: qa).
         Override here only if this suite must pin one environment. -->
    <parameter name="data.testId" value="testCaseId"/>
    <parameter name="api.retry.count" value="1"/>
    <parameter name="enableSessionsKeepAlive" value="true"/>
    <parameter name="executionTimeout" value="10000"/>
    <parameter name="cucumber.publish.quiet" value="true"/>
    <parameter name="cucumber.plugin"
               value="com.qapitol.sauron.report.core.cucumber.CucumberSauronReportEventsProvider"/>
    <parameter name="cucumber.glue" value="com.qapitol.jsw.stepdefinition,com.qapitol.jsw.utils"/>
    <parameter name="selfHeal" value="true"/>
    <parameter name="selfHeal.recovery.tries" value="2"/>
    <parameter name="selfHeal.score.cap" value="0.7"/>
    <parameter name="selfHeal.server" value="http://34.47.228.105:7878"/>
    <parameter name="selfHeal.imitator.server" value="http://34.47.228.105:8000"/>

<!-- ================================ LOGIN ================================ -->

    <test name="Login">
        <parameter name="test.group" value="login"/>
        <parameter name="sessions" value="sessions.yaml"/>
        <parameter name="cucumber.features" value="src/test/resources/features"/>
        <parameter name="cucumber.filter.tags" value="@login or @registration or @forgetPassword"/>
        <classes>
            <class name="com.qapitol.sauron.cucumber.SauronCucumberTest"/>
        </classes>
    </test>

    <!-- ================================ HOMEPAGE ================================ -->

    <test name="Homepage">
        <parameter name="test.group" value="homepage"/>
        <parameter name="sessions" value="sessions.yaml"/>
        <parameter name="cucumber.features" value="src/test/resources/features"/>
        <parameter name="cucumber.filter.tags" value="@header or @footer or @blogs or @search"/>
        <classes>
            <class name="com.qapitol.sauron.cucumber.SauronCucumberTest"/>
        </classes>
    </test>

    <test name="PDP_PLP">
        <parameter name="test.group" value="pdpplp"/>
        <parameter name="sessions" value="sessions.yaml"/>
        <parameter name="cucumber.features" value="src/test/resources/features"/>
        <parameter name="cucumber.filter.tags" value="@PLPValidation or @PDPValidation"/>
        <classes>
            <class name="com.qapitol.sauron.cucumber.SauronCucumberTest"/>
        </classes>
    </test>


    <!-- ================================== CART ================================== -->

    <!-- @AddToCartAndCreateOpportunity is a FEATURE-level tag, so this selects every active
         scenario in AddToCartAndCreateOpportunity.feature, not just the create-opportunity one. -->
    <test name="Cart_AddToCartAndCreateOpportunity">
        <parameter name="test.group" value="cart"/>
        <parameter name="sessions" value="sessions.yaml"/>
        <parameter name="cucumber.features" value="src/test/resources/features"/>
        <parameter name="cucumber.filter.tags"
                   value="@AddToCartAndCreateOpportunity"/>
        <classes>
            <class name="com.qapitol.sauron.cucumber.SauronCucumberTest"/>
        </classes>
    </test>


    <!-- =============================== SF ORDERS =============================== -->
    <!-- SFSlc.feature and SFSlo.feature have no Background - they drive Salesforce/API flows
         rather than a browser login - but they still run under the orders group's data. -->

    <test name="SF_SLC_SLO">
        <parameter name="test.group" value="orders"/>
        <parameter name="sessions" value="sessions.yaml"/>
        <parameter name="cucumber.features" value="src/test/resources/features"/>
        <parameter name="cucumber.filter.tags" value="@slcOrderCreation or @sloOrderCreation"/>
        <classes>
            <class name="com.qapitol.sauron.cucumber.SauronCucumberTest"/>
        </classes>
    </test>


    <!-- ================================= GUEST ================================= -->

    <test name="GuestHomePage">
        <parameter name="test.group" value="Guest"/>
        <parameter name="sessions" value="sessions.yaml"/>
        <parameter name="cucumber.features" value="src/test/resources/features"/>
        <parameter name="cucumber.filter.tags" value="@GuestUserHomePage"/>
        <classes>
            <class name="com.qapitol.sauron.cucumber.SauronCucumberTest"/>
        </classes>
    </test>


    <!-- =============================== TOKEN CHECK =============================== -->

    <!-- Both token features in one block: LoginUserToken logs in and closes the payment-due
         popup, GuestUserToken only opens the session.
         Runs under its own "tokencheck" group, which resolves to testautomation01@yopmail.com in
         both qa and preprod. It used to share the "profile" group, whose account is a real mailbox
         with a rotating password - that returned HTTP 401 and cost every token scenario in
         CCP_Regression #231. A dedicated group also keeps EmptyBankDetails, Address,
         CustomerDetails, bankDetails and forgetPassword on the profile account, untouched. -->
    <!-- <test name="TokenCheck">
        <parameter name="test.group" value="tokencheck"/>
        <parameter name="sessions" value="sessions.yaml"/>
        <parameter name="cucumber.features" value="src/test/resources/features"/>
        <parameter name="cucumber.filter.tags" value="@tokenCheckLogin or @tokenCheckGuestUser"/>
        <classes>
            <class name="com.qapitol.sauron.cucumber.SauronCucumberTest"/>
        </classes>
    </test> -->


    <!-- ================================ PROFILE ================================ -->

    <!-- EmptyBankDetails.feature logs in with credentials hardcoded in its own Background
         ("emailnoti@yopmail.com"), so test.group does not drive authentication here - it is
         set only because TestGroupContext requires a value. -->
    <test name="Profile">
        <parameter name="test.group" value="profile"/>
        <parameter name="sessions" value="sessions.yaml"/>
        <parameter name="cucumber.features" value="src/test/resources/features"/>
        <parameter name="cucumber.filter.tags" value="@customerDetails or @EmptyBankDetails"/>
        <classes>
            <class name="com.qapitol.sauron.cucumber.SauronCucumberTest"/>
        </classes>
    </test>


    <!-- ===========================================================================================
         Reference: areas NOT included above, with their verified tags. Uncomment the block you
         need, or add the tag to an existing block that already uses the right test.group.

           homepage : @paymentDue  @ledger  @bankDetails  @myAccount  @buym
           cart     : @CartVerification  @shipment  @EditAndDeleteCart  @ccpActiveOrder  @creditOrder
           profile  : @address
           orders   : @ccpErpSyncRegression
           Guest    : @SEOCheck
           api      : @customerProfileApi  @rcv2Api  @centralCart
                      (point cucumber.features at src/test/resources/features/api for these)
         =========================================================================================== -->

</suite>
