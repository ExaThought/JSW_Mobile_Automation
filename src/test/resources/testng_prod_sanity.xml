<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">

<suite verbose="1" name="JSW MSME Production Sanity" parallel="tests" thread-count="1"
       data-provider-thread-count="1" annotations="JDK">

    <listeners>
        <listener class-name="com.qapitol.jsw.config.TestGroupListener"/>
    </listeners>

    <parameter name="data.testId" value="testCaseId"/>
    <parameter name="api.retry.count" value="1"/>
    <parameter name="enableSessionsKeepAlive" value="true"/>
    <parameter name="executionTimeout" value="10000"/>
    <parameter name="cucumber.publish.quiet" value="true"/>
    <parameter name="cucumber.plugin"
               value="com.qapitol.sauron.report.core.cucumber.CucumberSauronReportEventsProvider"/>
    <parameter name="cucumber.glue" value="com.qapitol.jsw.stepdefinition,com.qapitol.jsw.utils"/>

    <!-- Self-heal is OFF for production, unlike testng_bdd.xml. It rewrites locators at runtime
         against a remote service, and a production run has to report what the site actually
         does - not what a healed locator managed to find. A rotted locator on production is
         itself a finding. -->
    <parameter name="selfHeal" value="false"/>

    <test name="Production_Sanity">
        <parameter name="test.group" value="login"/>
        <parameter name="env" value="prod"/>
        <parameter name="sessions" value="sessions.yaml"/>
        <parameter name="cucumber.features" value="src/test/resources/features"/>
        <!-- A conjunction, not bare @P0. @P0 is a generic priority tag: nothing stops a future
             scenario anywhere in the repo from carrying it, and a bare @P0 filter would make that
             scenario eligible for -Denv=prod the moment it was written. @productionSanity is the
             tag that actually denotes "vetted to run against www.jswonemsme.com", so it has to be
             part of the expression. Keep both operands - dropping either widens the blast radius.
             `and` must stay lowercase; Cucumber tag expressions reject `AND`. -->
        <parameter name="cucumber.filter.tags" value="@productionSanity and @P0"/>
        <classes>
            <class name="com.qapitol.sauron.cucumber.SauronCucumberTest"/>
        </classes>
    </test>

</suite>